{
  "name": "kickoff-division",
  "version": "3.10.1",
  "private": true,
  "description": "KickOff Division — zero-server football league manager",
  "scripts": {
    "serve": "node tools/serve.js",
    "build:css": "tailwindcss -i ./css/tailwind.input.css -o ./css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./css/tailwind.input.css -o ./css/tailwind.css --watch",
    "test:sql": "node tools/test-sql-integrity.js",
    "test:e2e": "playwright test",
    "check:secrets": "node tools/check-secrets.js",
    "check:backup": "node tools/validate-backup.js",
    "drill:backup": "node tools/restore-drill.js",
    "backup:prod": "node tools/export-backup.js --env=prod",
    "backup:dev": "node tools/export-backup.js --env=dev",
    "keepalive:prod": "node tools/keepalive.js --env=prod"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.6",
    "@playwright/test": "1.64.1",
    "tailwindcss": "3.4.17"
  }
}
